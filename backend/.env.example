# 서버에서만 설정하며, 실제 .env 파일은 Git에 올리지 않습니다.
RAILS_ENV=development

# 기기 등록 시 필요한 개인 접속 키. production에서는 반드시 설정해야 하며
# 미설정 시 /devices/activate가 실패합니다.
PERSONAL_ACCESS_KEY=

# production 필수: 외부 도메인 (예: api.example.com). Rails host 검증에 사용.
APP_HOST=

# 웹 PWA를 별도 도메인에서 서빙하는 경우 그 origin (예: https://app.example.com)
WEB_ORIGIN=

# production 필수: `bin/rails secret`으로 생성. 세션/서명 키의 뿌리 값입니다.
SECRET_KEY_BASE=

# SQLite 파일 위치 (기본: storage/production.sqlite3). 영속 볼륨 경로로 지정하세요.
DATABASE_PATH=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
EXPO_ACCESS_TOKEN=
