# iPhone에서는 localhost가 아니라, 외부에서 HTTPS로 접근 가능한 API 주소를 사용하세요.
EXPO_PUBLIC_API_URL=https://your-tracker.example.com/api/v1

# Expo 푸시 알림을 쓰려면 EAS 프로젝트 ID를 넣으세요.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# 웹 푸시를 쓰는 경우에만 필요합니다.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# 서버의 PERSONAL_ACCESS_KEY와 동일한 값. 최초 기기 등록 시 사용합니다.
EXPO_PUBLIC_PERSONAL_ACCESS_KEY=your-personal-access-key
